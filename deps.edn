{:paths ["src"]

 ;; Clojure 1.11 is the floor, and the tests run on it unless an alias says
 ;; otherwise. data.json reads and writes the messages of the DevTools
 ;; protocol, which the JVM side uses to drive Chrome.
 :deps  {org.clojure/clojure   {:mvn/version "1.11.4"}
         org.clojure/data.json {:mvn/version "2.5.2"}}

 :aliases
 {;; clojure -X:test
  :test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts   ["-m" "cognitect.test-runner"]
         :exec-fn     cognitect.test-runner.api/test}

  ;; clojure -M:cljs compile test  (the tests of the .cljc core in Node)
  :cljs {:extra-paths   ["test"]
         :override-deps {org.clojure/clojure {:mvn/version "1.12.6"}}
         :extra-deps    {thheller/shadow-cljs {:mvn/version "3.5.8"}}
         :main-opts     ["-m" "shadow.cljs.devtools.cli"]}}}
